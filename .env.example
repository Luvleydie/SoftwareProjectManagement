# Variables de entorno del proyecto juridIA.
# Copia este archivo a backend/.env y ajusta los valores locales.
# Las variables del proceso tienen prioridad sobre las del archivo.

# --- Stack objetivo: PostgreSQL ---
# JURIDIA_DATABASE_URL=postgresql+psycopg://juridia:password@localhost:5432/juridia

# --- Prototipo actual: MySQL/XAMPP (se retira al migrar a PostgreSQL) ---
# JURIDIA_MYSQL_USER=juridia_app
# JURIDIA_MYSQL_PASSWORD=your-local-password
# JURIDIA_MYSQL_DATABASE=juridia

# --- Fallback de desarrollo: SQLite ---
# JURIDIA_DATABASE_URL=sqlite:///./juridia.db

JURIDIA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
JURIDIA_SECURE_COOKIES=false

# Modelo local Ollama (no se descarga automáticamente)
JURIDIA_AI_MODEL=qwen3.5:4b-q4_K_M
JURIDIA_OLLAMA_URL=http://127.0.0.1:11434
