@startuml
!pragma layout smetana
hide circle
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #526E87
skinparam entityBackgroundColor #EAF3FA
skinparam noteBackgroundColor #FFF4D6
skinparam nodesep 50
skinparam ranksep 55
top to bottom direction

' Generado desde §9 por scripts/generar_modelo_er.py; editar el Mermaid de origen.
title
D09c · Fuentes, recuperación y evidencia
Claves y cardinalidades · diccionario completo en §8
end title
entity "documents" as documents {
  id : uuid <<PK>>
  case_id : uuid <<FK>>
  artifact_id : uuid <<FK,UK>>
  job_id : uuid <<FK>>
  object_key : text
  ingestion_state : text
  security_state : text
}
entity "legal_sources" as legal_sources {
  id : uuid <<PK>>
  title : text
  canonical_url : text
  country : text
  status : text
}
entity "source_versions" as source_versions {
  id : uuid <<PK>>
  source_id : uuid <<FK>>
  job_id : uuid <<FK>>
  version_label : text
  effective_from : date
  effective_to : date
  status : text
  ingestion_state : text
}
entity "chunks" as chunks {
  id : uuid <<PK>>
  document_id : uuid <<FK>>
  source_version_id : uuid <<FK>>
  ordinal : integer
  locator : jsonb
  text : text
  embedding : vector
  active : boolean
}
entity "ai_runs" as ai_runs {
  id : uuid <<PK>>
  case_id : uuid <<FK>>
  artifact_id : uuid <<FK,UK>>
  job_id : uuid <<FK,UK>>
  input_message_id : uuid <<FK>>
  state : text
  model_version : text
  prompt_version : text
  retrieval_parameters : jsonb
}
entity "retrieved_evidence" as retrieved_evidence {
  run_id : uuid <<PK,FK>>
  chunk_id : uuid <<PK,FK>>
  rank : integer
  score : float
}
entity "citations" as citations {
  id : uuid <<PK>>
  run_id : uuid <<FK>>
  chunk_id : uuid <<FK>>
  claim_locator : text
  passage_start : integer
  passage_end : integer
}
entity "analyses" as analyses {
  id : uuid <<PK>>
  document_id : uuid <<FK>>
  run_id : uuid <<FK,UK>>
  artifact_id : uuid <<FK,UK>>
  findings : jsonb
}
legal_sources ||--o{ source_versions : versiona
documents |o--o{ chunks : origen_privado
source_versions |o--o{ chunks : origen_oficial
ai_runs ||--o{ retrieved_evidence : recupera
chunks ||--o{ retrieved_evidence : evidencia
retrieved_evidence ||--o{ citations : respalda
documents ||--o{ analyses : analiza
ai_runs ||--o| analyses : produce
legend bottom
PK = primaria · FK = foránea · UK = única · o = opcional · | = uno · { = varios
Atributos estructurales; obligatoriedad, enums, índices y restricciones completos en §8.
Vista parcial: las tablas repetidas designan las mismas entidades; todas las relaciones figuran en D09.
chunks: exactamente un origen, document_id o source_version_id.
citations(run_id,chunk_id) referencia el par efectivamente recuperado en retrieved_evidence.
endlegend
@enduml
