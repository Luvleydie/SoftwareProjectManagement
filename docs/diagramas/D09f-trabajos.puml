@startuml
!pragma layout smetana
hide circle
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #526E87
skinparam entityBackgroundColor #EAF3FA
skinparam noteBackgroundColor #FFF4D6
skinparam nodesep 50
skinparam ranksep 55
top to bottom direction

' Generado desde §9 por scripts/generar_modelo_er.py; editar el Mermaid de origen.
title
D09f · Trabajos persistidos y recursos procesados
Claves y cardinalidades · diccionario completo en §8
end title
entity "users" as users {
  id : uuid <<PK>>
  email : text <<UK>>
  password_hash : text
  role : text
  status : text
}
entity "documents" as documents {
  id : uuid <<PK>>
  case_id : uuid <<FK>>
  artifact_id : uuid <<FK,UK>>
  job_id : uuid <<FK>>
  object_key : text
  ingestion_state : text
  security_state : text
}
entity "source_versions" as source_versions {
  id : uuid <<PK>>
  source_id : uuid <<FK>>
  job_id : uuid <<FK>>
  version_label : text
  effective_from : date
  effective_to : date
  status : text
  ingestion_state : text
}
entity "ai_runs" as ai_runs {
  id : uuid <<PK>>
  case_id : uuid <<FK>>
  artifact_id : uuid <<FK,UK>>
  job_id : uuid <<FK,UK>>
  input_message_id : uuid <<FK>>
  state : text
  model_version : text
  prompt_version : text
  retrieval_parameters : jsonb
}
entity "privacy_requests" as privacy_requests {
  id : uuid <<PK>>
  user_id : uuid <<FK>>
  job_id : uuid <<FK,UK>>
  kind : text
  state : text
  receipt_hash : text <<UK>>
  receipt_expires_at : timestamptz
}
entity "exports" as exports {
  id : uuid <<PK>>
  owner_id : uuid <<FK>>
  artifact_id : uuid <<FK,UK>>
  job_id : uuid <<FK,UK>>
  origin_kind : text
  conversation_id : uuid <<FK>>
  draft_id : uuid <<FK>>
  draft_revision : integer
  privacy_request_id : uuid <<FK>>
  state : text
  object_key : text
}
entity "jobs" as jobs {
  id : uuid <<PK>>
  requested_by : uuid <<FK>>
  kind : text
  state : text
  input_refs : jsonb
  observed_generations : jsonb
  lease_token : uuid
  lease_until : timestamptz
}
users ||--o{ privacy_requests : solicita
users ||--o{ exports : descarga
users |o--o{ jobs : solicita
privacy_requests |o--o{ exports : exporta
jobs ||--o{ documents : ingiere
jobs ||--o{ source_versions : indexa
jobs ||--o| ai_runs : ejecuta
jobs ||--o| privacy_requests : procesa
jobs ||--o| exports : construye
legend bottom
PK = primaria · FK = foránea · UK = única · o = opcional · | = uno · { = varios
Atributos estructurales; obligatoriedad, enums, índices y restricciones completos en §8.
Vista parcial: las tablas repetidas designan las mismas entidades; todas las relaciones figuran en D09.
jobs.requested_by puede ser NULL para trabajo del sistema; leases y generaciones protegen la publicación.
endlegend
@enduml
